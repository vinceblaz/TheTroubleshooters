  "description": "Système Foundry VTT pour The Troubleshooters : les Risque-tout (Helmgast AB / Arkhane Asylum Publishing). Œuvre de fan non officielle, non approuvée par les éditeurs ni par les titulaires des droits. Aucune illustration du livre n'est incluse ; le livre de base est nécessaire pour jouer.",
  "version": "0.1.0",
  "license": "LICENSE",
  "url": "https://github.com/vinceblaz/TheTroubleshooters",
  "readme": "https://github.com/vinceblaz/TheTroubleshooters#readme",
  "bugs": "https://github.com/vinceblaz/TheTroubleshooters/issues",
  "changelog": "https://github.com/vinceblaz/TheTroubleshooters/blob/main/CHANGELOG.md",
  "socket": true,
  "compatibility": {
    "minimum": "14",
    "verified": "14.369"
  },
  "authors": [
    {
      "name": "Vincent Blazy",
      "url": "https://github.com/vinceblaz"
    }
  ],
  "esmodules": [
    "src/system.mjs"
  ],
  "styles": [
    "styles/tts-base.css",
    "styles/tts-character.css",
    "styles/tts-npc.css",
    "styles/tts-items.css"
  ],
  "languages": [
    {
      "lang": "fr",
      "name": "Français",
      "path": "lang/fr.json"
    }
  ],
  "documentTypes": {
    "Actor": {
      "character": { "htmlFields": ["identity.biography", "identity.meeting", "notes", "clues"] },
      "npc": { "htmlFields": ["description"] }
    },
    "Item": {
      "archetype": { "htmlFields": ["description"] },
      "ability": { "htmlFields": ["description"] },
      "flaw": { "htmlFields": ["description"] },
      "hook": { "htmlFields": ["description"] },
      "kit": { "htmlFields": ["description"] },
      "language": {}
    }
  },
  "primaryTokenAttribute": "vitality",
  "initiative": "1d100",
  "grid": {
    "distance": 1,
    "units": "m"
  }
}
