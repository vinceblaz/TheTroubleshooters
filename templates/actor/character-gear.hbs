<section class="tab tts-tab-body {{tab.cssClass}}" data-group="primary" data-tab="gear">
  {{#if gear.signature.over}}<p class="tts-warning">{{localize "TTS.Kit.SignatureOver"}} ({{gear.signature.count}} / {{gear.signature.max}})</p>{{/if}}
  {{#each gear.signature.missingDescription as |n|}}<p class="tts-warning">{{n}} : {{localize "TTS.Kit.SignatureNeedsDescription"}}</p>{{/each}}

  {{> "systems/thetroubleshooters/templates/actor/parts/kit-table.hbs" rows=gear.carried title="TTS.Kit.CarriedSection" counter=true slots=gear.slots editable=editable create=true}}
  {{#if gear.slots.over}}<p class="tts-warning">{{localize "TTS.Kit.OverLimit"}}</p>{{/if}}
  {{> "systems/thetroubleshooters/templates/actor/parts/kit-table.hbs" rows=gear.storage title="TTS.Kit.Storage" editable=editable}}
  {{> "systems/thetroubleshooters/templates/actor/parts/kit-table.hbs" rows=gear.found title="TTS.Kit.FoundItems" editable=editable}}
  <p class="tts-hint">{{localize "TTS.Kit.GearHint"}}</p>
</section>
