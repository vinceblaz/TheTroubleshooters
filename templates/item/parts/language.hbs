<div class="tts-grid-3">
  <label class="tts-check-label"><input name="system.fluent" type="checkbox" {{checked system.fluent}}> {{localize "TTS.Language.Fluent"}}</label>
  <label class="tts-check-label"><input name="system.native" type="checkbox" {{checked system.native}}> {{localize "TTS.Language.Native"}}</label>
  <div class="form-group"><label>{{localize "TTS.Language.Crosses"}}</label><input name="system.crosses" type="number" value="{{system.crosses}}" min="0" max="5"></div>
</div>
<p class="tts-hint">{{localize "TTS.Language.Hint"}}</p>
