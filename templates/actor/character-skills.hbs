<section class="tab tts-tab-body {{tab.cssClass}}" data-group="primary" data-tab="skills">
  <p class="tts-hint">{{localize "TTS.Skill.Hint"}}</p>
  <div class="tts-skill-families">
    {{#each families as |fam|}}
    <fieldset class="tts-skill-family">
      <legend>{{localize fam.label}}</legend>
      <table class="tts-skill-table">
        <tbody>
          {{#each fam.skills as |skill|}}
          <tr class="tts-skill-row" data-skill="{{skill.key}}">
            <td class="tts-skill-label">{{localize skill.label}}</td>
            <td class="tts-skill-value"><input name="system.skills.{{skill.key}}.value" type="number" value="{{skill.value}}" min="15" max="106" step="1"><span>%</span></td>
            <td class="tts-skill-tick">
              <input name="system.skills.{{skill.key}}.improvement" type="checkbox" {{checked skill.improvement}} data-tooltip="TTS.Skill.Improvement" aria-label="{{localize 'TTS.Skill.Improvement'}}">
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </fieldset>
    {{/each}}
  </div>
</section>
