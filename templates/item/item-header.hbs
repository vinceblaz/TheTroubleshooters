<header class="tts-sheet-header tts-item-header">
  <img class="tts-portrait" src="{{item.img}}" alt="{{item.name}}" data-edit="img" data-action="editImage" width="64" height="64">
  <div class="tts-header-main">
    <input class="tts-name" name="name" type="text" value="{{item.name}}" placeholder="{{localize 'TTS.Sheet.Name'}}">
    <span class="tts-item-type">{{localize (concat "TYPES.Item." item.type)}}</span>
  </div>
</header>
