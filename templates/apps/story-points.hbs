<div class="tts-sp-app">
  <table class="tts-row-table">
    <thead><tr><th></th><th>{{localize "TTS.SP.Character"}}</th><th>PR</th><th>{{localize "TTS.SP.PendingBonus"}}</th><th></th></tr></thead>
    <tbody>
      {{#each rows as |r|}}
      <tr data-actor-id="{{r.id}}">
        <td class="tts-check"><input type="checkbox" name="selected" value="{{r.id}}" checked></td>
        <td><img src="{{r.img}}" alt="" width="24" height="24"> {{r.name}}</td>
        <td class="tts-sp-value"><strong>{{r.value}}</strong> / {{../max}}</td>
        <td class="tts-num">{{#if r.bonus}}+{{r.bonus}}{{/if}}</td>
        <td class="tts-row-controls">
          <button type="button" data-action="adjust" data-delta="-1">−1</button>
          <button type="button" data-action="adjust" data-delta="1">+1</button>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="tts-empty">{{localize "TTS.SP.NoCharacters"}}</td></tr>
      {{/each}}
    </tbody>
  </table>
  <fieldset class="tts-fieldset">
    <legend>{{localize "TTS.SP.ForSelection"}}</legend>
    <div class="tts-card-buttons">
      <button type="button" data-action="group" data-kind="captured"><i class="fa-solid fa-handcuffs"></i> {{localize "TTS.SP.Captured"}} (+9)</button>
      <button type="button" data-action="group" data-kind="amuse"><i class="fa-solid fa-face-laugh"></i> {{localize "TTS.SP.Amuse"}} (+1)</button>
      <button type="button" data-action="group" data-kind="signature"><i class="fa-solid fa-star"></i> {{localize "TTS.SP.Signature"}} (+3)</button>
      <button type="button" data-action="wipe"><i class="fa-solid fa-skull"></i> {{localize "TTS.SP.Wipe"}}</button>
    </div>
  </fieldset>
  <div class="tts-card-buttons">
    <button type="button" data-action="newSession"><i class="fa-solid fa-calendar-plus"></i> {{localize "TTS.SP.NewSession"}}</button>
    <button type="button" data-action="newScene"><i class="fa-solid fa-clapperboard"></i> {{localize "TTS.Scene.New"}}</button>
  </div>
</div>
